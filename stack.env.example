# ---------------------------------------------------------------------------
# Media stack configuration. Copy to stack.env, fill in, then run deploy.sh.
#
#   cp stack.env.example stack.env && chmod 600 stack.env
#
# stack.env holds a VPN private key and two channel credentials. It is chmod 600,
# it is in .gitignore, and it must never be committed anywhere.
# ---------------------------------------------------------------------------

# --- paths -----------------------------------------------------------------
# STACK_HOME is the user's home. Everything else hangs off it.
STACK_HOME=/home/YOUR_USER
ARR_DIR=${STACK_HOME}/services/arr
NTFY_DIR=${STACK_HOME}/services/ntfy-control

# Where media and downloads live. These MUST be the same filesystem, or the arr
# apps fall back to copying instead of hardlinking and you burn double the disk
# while seeding breaks on import. deploy.sh refuses to continue if they differ.
MEDIA_ROOT=/mnt/media

# --- identity --------------------------------------------------------------
# The linuxserver images run as this uid/gid. It must be the user that owns
# ARR_DIR and MEDIA_ROOT, or containers write files nothing else can read.
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- network ---------------------------------------------------------------
# This host's Tailscale address. Admin UIs bind here and on 127.0.0.1 only, so
# nothing but Jellyfin is reachable from the LAN.
#   tailscale ip -4
TAILNET_IP=100.100.100.100

# The tailnet DNS name, used for `tailscale serve` HTTPS.
#   tailscale status --json | grep DNSName
TAILNET_HOST=your-host.your-tailnet.ts.net

# --- ProtonVPN (gluetun) ---------------------------------------------------
# From account.protonvpn.com -> Downloads -> WireGuard configuration.
# Pick a P2P server and ENABLE NAT-PMP (port forwarding), or torrents get no
# incoming connections at all. Copy PrivateKey and Address out of the .conf.
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=PASTE_YOUR_PRIVATE_KEY_HERE
WIREGUARD_ADDRESSES=10.2.0.2/32

# Subnets allowed to bypass the tunnel, so the WebUI stays reachable. Must
# include your LAN, the tailnet CGNAT range, and the podman bridge.
FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24,100.64.0.0/10,10.89.0.0/16

# --- ntfy ------------------------------------------------------------------
# Two SEPARATE random topics. The topic NAME is the only credential ntfy.sh
# anonymous accounts have (0 reservations), so treat both like passwords —
# anyone who learns the command topic can run whitelisted commands on this host.
# Generate:  head -c 12 /dev/urandom | base32 | tr '[:upper:]' '[:lower:]' | tr -d '='
NTFY_ALERT_TOPIC=CHANGE_ME_alerts
NTFY_CMD_TOPIC=CHANGE_ME_commands

# Second factor for `repair`, the one command that lets Claude change things.
# Generate:  head -c 9 /dev/urandom | base32 | tr -d '='
FIX_TOKEN=CHANGE_ME_TOKEN

# --- jellystat -------------------------------------------------------------
# Postgres credentials for the jellystat analytics database, and its session
# signing secret. These are internal - nothing outside the container network ever
# sees them - so random values are correct. deploy.sh generates them if left blank,
# and NEVER rewrites config/jellystat.env once it exists (changing the password
# after the database is initialised locks jellystat out of its own data).
# Generate:  head -c 18 /dev/urandom | base64
JELLYSTAT_DB_PASSWORD=
JELLYSTAT_JWT_SECRET=

# Deluge WebUI password. The linuxserver image default is "deluge" — change it
# in the WebUI, then set the same value here so wire.sh can register the client.
DELUGE_PASSWORD=deluge

# --- optional --------------------------------------------------------------
# Container network name. Only change this if 'arr' collides with something.
ARR_NETWORK=arr
