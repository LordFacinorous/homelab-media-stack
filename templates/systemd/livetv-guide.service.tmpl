[Unit]
Description=Rebuild the Live TV playlist and EPG for Jellyfin
# Nothing watched these before: uptime-kuma sees dead endpoints, not units that ran
# and failed. The nightly backup failed silently on 2026-09-06 because of that gap.
OnFailure=ntfy-alert@%n.service
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=${ARR_DIR}/livetv-guide.sh
Nice=10
IOSchedulingClass=idle
