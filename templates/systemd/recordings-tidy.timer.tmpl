[Unit]
Description=Live TV recording tidy (hourly)

[Timer]
# Hourly, not nightly: Jellyfin writes new recordings to <root>/<Series>/ while the
# Jellyfin library points at <root>/Shows/. Until the tidy relocates them they are
# invisible in the UI, and these channels record every hour.
OnCalendar=*-*-* *:12:00
RandomizedDelaySec=5m
Persistent=true

[Install]
WantedBy=timers.target
