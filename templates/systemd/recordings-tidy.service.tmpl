[Unit]
Description=De-duplicate Live TV recordings and sort shows from movies
# Nothing watched these before: uptime-kuma sees dead endpoints, not units that ran
# and failed. The nightly backup failed silently on 2026-09-06 because of that gap.
OnFailure=ntfy-alert@%n.service
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=${ARR_DIR}/recordings-tidy.sh --apply
Nice=10
IOSchedulingClass=idle
