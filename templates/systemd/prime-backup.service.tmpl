[Unit]
Description=Encrypted incremental backup of PRIME's irreplaceable data to Google Drive
# Nothing watched these before: uptime-kuma sees dead endpoints, not units that ran
# and failed. The nightly backup failed silently on 2026-09-06 because of that gap.
OnFailure=ntfy-alert@%n.service
After=network-online.target

[Service]
Type=oneshot
ExecStart=${STACK_HOME}/services/backup/backup.sh
# uplink is ~8Mbit/s and shared - stay off the throat of it
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
TimeoutStartSec=6h
