[Unit]
Description=jellyseerr (arr suite)
RequiresMountsFor=${MEDIA_ROOT}
After=network-online.target

[Container]
ContainerName=jellyseerr
Image=docker.io/fallenbagel/jellyseerr:latest
UserNS=keep-id
Environment=PUID=${PUID}
Environment=PGID=${PGID}
Environment=TZ=${TZ}
Volume=${ARR_DIR}/config/jellyseerr:/app/config
Volume=${MEDIA_ROOT}:/data
Network=arr.network
PublishPort=127.0.0.1:5055:5055
PublishPort=${TAILNET_IP}:5055:5055

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
