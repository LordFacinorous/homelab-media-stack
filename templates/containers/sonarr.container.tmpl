[Unit]
Description=sonarr (arr suite)
RequiresMountsFor=${MEDIA_ROOT}
After=network-online.target

[Container]
ContainerName=sonarr
Image=docker.io/linuxserver/sonarr:latest
UserNS=keep-id
Environment=PUID=${PUID}
Environment=PGID=${PGID}
Environment=TZ=${TZ}
Volume=${ARR_DIR}/config/sonarr:/config
Volume=${MEDIA_ROOT}:/data
Network=arr.network
PublishPort=127.0.0.1:8989:8989
PublishPort=${TAILNET_IP}:8989:8989

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
