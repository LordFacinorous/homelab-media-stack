[Unit]
Description=uptime-kuma (service monitoring)
After=network-online.target
[Container]
ContainerName=uptime-kuma
Image=docker.io/louislam/uptime-kuma:1
Environment=TZ=${TZ}
Volume=${ARR_DIR}/config/uptime-kuma:/app/data
Network=arr.network
PublishPort=127.0.0.1:3001:3001
PublishPort=${TAILNET_IP}:3001:3001
[Service]
Restart=on-failure
TimeoutStartSec=900
[Install]
WantedBy=default.target
