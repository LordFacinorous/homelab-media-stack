[Unit]
Description=bazarr (arr suite - subtitles)
RequiresMountsFor=${MEDIA_ROOT}
After=network-online.target

[Container]
ContainerName=bazarr
Image=docker.io/linuxserver/bazarr:latest
UserNS=keep-id
Environment=PUID=${PUID}
Environment=PGID=${PGID}
Environment=TZ=${TZ}
Volume=${ARR_DIR}/config/bazarr:/config
Volume=${MEDIA_ROOT}:/data
Network=arr.network
PublishPort=127.0.0.1:6767:6767
PublishPort=${TAILNET_IP}:6767:6767

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
