[Unit]
Description=unpackerr (extracts RAR'd downloads so arr can import them)
RequiresMountsFor=${MEDIA_ROOT}
After=network-online.target

[Container]
ContainerName=unpackerr
Image=ghcr.io/unpackerr/unpackerr:latest
UserNS=keep-id
Environment=TZ=${TZ}
Environment=UN_SONARR_0_URL=http://sonarr:8989
Environment=UN_SONARR_0_API_KEY=d61c859a7fdd4010a362c185c6dd984a
Environment=UN_SONARR_0_PATHS_0=/data/downloads
Environment=UN_RADARR_0_URL=http://radarr:7878
Environment=UN_RADARR_0_API_KEY=e610c339c5c740258467b0febba13564
Environment=UN_RADARR_0_PATHS_0=/data/downloads
Environment=UN_LIDARR_0_URL=http://lidarr:8686
Environment=UN_LIDARR_0_API_KEY=0ef895c8e8704866bdf6ef10d06f0806
Environment=UN_LIDARR_0_PATHS_0=/data/downloads
Environment=UN_LOG_FILE=/config/unpackerr.log
Volume=${ARR_DIR}/config/unpackerr:/config
Volume=${MEDIA_ROOT}:/data
Network=arr.network

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
